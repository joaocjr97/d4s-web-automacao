# =============================================================================
# AMBIENTE D4Sign
# Valor ENVIRONMENT -> URL base usada nos testes (login, desk e embed)
# =============================================================================
# prod    / secure  -> https://secure.d4sign.com.br/
# homol             -> https://homol.d4sign.com.br/
# staging / stage   -> https://stage.d4sign.com.br/
# hotfix            -> https://hotfix.d4sign.com.br/
ENVIRONMENT=homol

# =============================================================================
# CREDENCIAIS (conta de teste do ambiente acima)
# D4S_USERNAME evita conflito com a variável USERNAME do Windows
# =============================================================================
D4S_USERNAME=
D4S_PASSWORD=

# =============================================================================
# API (opcional — fluxos que usam token)
# =============================================================================
TOKEN_API=
CRYPT_KEY=
EMAIL_TESTE=

# =============================================================================
# EMBED (Tryit W3Schools — visualiza a viewblob, teste não assina)
# UUID único: prod, homol, stage e hotfix compartilham o banco.
# A URL do iframe segue ENVIRONMENT:
#   prod/secure -> https://secure.d4sign.com.br/embed/viewblob/<uuid>
#   homol       -> https://homol.d4sign.com.br/embed/viewblob/<uuid>
#   stage       -> https://stage.d4sign.com.br/embed/viewblob/<uuid>
#   hotfix      -> https://hotfix.d4sign.com.br/embed/viewblob/<uuid>
# =============================================================================
EMBED_DOCUMENT_UUID=a87946d3-49b3-4a01-98c2-460228233bc2

# =============================================================================
# NAVEGADOR
# =============================================================================
BROWSER=chrome
HEADLESS=false

# =============================================================================
# TIMEOUTS (segundos)
# TIMEOUT        -> espera de negócio (documento processar, lote finalizar...)
# ACTION_TIMEOUT -> timeout padrão nativo do Playwright p/ ações (click/fill/
#                   select_option) sem timeout explícito. Mantenha baixo:
#                   ação de UI travando por minutos geralmente é bug real,
#                   não algo a esperar.
# =============================================================================
TIMEOUT=60
ACTION_TIMEOUT=30
LOGIN_TIMEOUT=20

# =============================================================================
# EVIDÊNCIAS
# =============================================================================
SCREENSHOT_ON_FAIL=false
RECORD_VIDEO=false
RECORD_TRACE=false
# true = screenshot de TODO step + vídeo/trace completos em TODO cenário
# (passou ou falhou). Bom pra debugar local; deixe false no CI (fica pesado).
EVIDENCE_ALWAYS=false
