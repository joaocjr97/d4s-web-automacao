# Ambiente: ghost | homol | staging | hotfix | prod
ENVIRONMENT=prod

# Credenciais de login (D4S_USERNAME evita conflito com variável USERNAME do Windows)
D4S_USERNAME=seu_email@exemplo.com
D4S_PASSWORD=sua_senha

# Chaves de API
TOKEN_API=sua_token_api
CRYPT_KEY=sua_crypt_key

# Dados de teste
EMAIL_TESTE=email_para_testes@exemplo.com

# Navegador: chrome | firefox
BROWSER=chrome

# true = headless | false = com tela visível
HEADLESS=false

# Timeout em segundos (fluxos longos: envios)
TIMEOUT=240

# Timeout para login (cenários curtos)
LOGIN_TIMEOUT=20

# Evidências
SCREENSHOT_ON_FAIL=true
# false acelera execução local dos testes de login
RECORD_VIDEO=true
